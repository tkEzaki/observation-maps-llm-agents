# --- generated analysis outputs -------------------------------------------
# The analysis tree holds code; its outputs are generated by running the
# scripts and are shipped separately, immutably, under results_frozen/.
analysis/**
!analysis/**/
!analysis/**/*.py
!analysis/**/*.md

# --- acquisition traces ---------------------------------------------------
# Everything the study acquired is tracked here: the derived per-run state
# (phase trajectories, sampled actions, stimuli, metadata) and the raw model
# responses (trace.jsonl).  About 314 MB uncompressed across 15 acquisition
# groups; git packs it to a fraction of that, and no single file approaches
# GitHub's per-file limit, so Git LFS is not used.
#
# The three *_mock groups are pipeline smoke tests run against a synthetic
# backend (backend "mock", model "attractive-v1").  They contain no model
# calls and no results, and are not released.
runs/*_mock/**
runs/**/*.log

# --- rendered figures ------------------------------------------------------
# PDFs are tracked (they are the manuscript's display items); the PNG previews
# are regenerated by every build and are not.
figures/**/*.png



# --- local -----------------------------------------------------------------
.env
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
*.pid
*.log
